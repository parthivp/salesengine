# Copy to .env and fill in the required values. A blank value is treated as unset,
# so anything you leave alone falls back to the documented default.

NODE_ENV=development

# --- Required ---------------------------------------------------------------

# Runtime connection. Use the restricted role: row-level security applies to it,
# and that is the backstop that keeps one tenant out of another's rows.
DATABASE_URL="postgresql://salesengine_app:password@localhost:5432/salesengine"

# Migrations and seeds. Owner role, BYPASSRLS. Prisma uses this for `migrate` and
# `db seed` only. If you point both at the owner role, RLS stops protecting you.
DIRECT_DATABASE_URL="postgresql://salesengine:password@localhost:5432/salesengine"

# Session signing. At least 32 characters: openssl rand -hex 32
AUTH_SECRET=""

# Credential encryption at rest (AES-256-GCM). Exactly 32 bytes: openssl rand -hex 16
ENCRYPTION_KEY=""

# Password for the restricted runtime role (salesengine_app). Docker Compose
# refuses to start without it, and `npm run db:provision` sets it on the role.
# The migration creates that role with a placeholder, because a migration cannot
# read your secrets — leaving the placeholder is a default credential on the
# account holding all customer data.
APP_DB_PASSWORD=""

# --- Optional, with defaults -------------------------------------------------

REDIS_URL="redis://localhost:6379"
APP_URL="http://localhost:3000"

# Which transport actually sends:
#   log  — write the message to the log and send nothing. Use for development.
#   ses  — send through Amazon SES.
#   auto — SES when AWS credentials are present, otherwise log. This is the
#          default, and it is the one to think about: ambient credentials on a CI
#          runner or a laptop with a shared AWS profile will arm real sending
#          without anyone choosing it. Set 'log' explicitly anywhere you are not
#          certain you want mail leaving the machine.
# "live" actually sends; "log" writes what it would have sent to the worker log.
# Which transport "live" uses is a property of the mailbox: Microsoft 365 sends
# through Graph, an SES-backed mailbox through SES.
EMAIL_TRANSPORT="log"

AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_CONFIGURATION_SET=""

# Enrichment. Without it, enrichment is skipped rather than failing.
APOLLO_API_KEY=""

# Rewrites a rough draft into a polished one, grounded in the facts already on the
# record. Optional — without it the Improve button simply does not appear.
# Get a key at platform.openai.com; it is separate from a ChatGPT subscription.
OPENAI_API_KEY=""
# Any current OpenAI model id. Cost is negligible at this volume — a few pounds a
# month at most — so this defaults to a capable model rather than the cheapest.
#   gpt-5.6-luna   cheapest, fine for a first look
#   gpt-5.6-terra  the default; good balance
#   gpt-5.5        if the drafts still are not landing
OPENAI_MODEL="gpt-5.6-terra"

# Salesforce connected app, for the CRM connector's OAuth flow.
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
