    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "db:rescore": "tsx scripts/rescore.ts",
    "db:seed-sequences": "tsx scripts/seed-sequences.ts",
    "start:standalone": "./scripts/prepare-standalone.sh && node .next/standalone/server.js",
    "db:seed-crm": "tsx scripts/seed-crm.ts",
    "db:seed-workflow": "tsx scripts/seed-workflow.ts",
    "db:seed-owner-tasks": "tsx scripts/seed-owner-tasks.ts",
    "db:provision": "tsx scripts/provision-db.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1098.0",
    "@date-fns/tz": "^1.5.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "bullmq": "5.81.3",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "^17.4.2",
    "imapflow": "1.6.5",
    "ioredis": "5.11.1",
    "jose": "6.1.0",
    "lucide-react": "0.544.0",
    "mailparser": "3.9.14",
    "nanoid": "5.1.5",
    "next": "^16.2.12",
    "papaparse": "5.5.3",
    "pino": "9.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.3.1",
    "zod": "3.25.76"
