    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "^16.2.12",
    "playwright": "^1.62.0",
    "postcss": "8.5.25",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
